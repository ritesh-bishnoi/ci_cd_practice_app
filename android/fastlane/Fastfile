default_platform(:android)

platform :android do
  desc "Bump build number based on GitHub run number"
  lane :bump_build_number do
    version_code = ENV['GITHUB_RUN_NUMBER'] || '1'
    sh("cd .. && sed -i.bak -E 's/^version: (.+)\\+[0-9]+/version: \\1+#{version_code}/' pubspec.yaml")
  end
  
  desc "Build a signed release APK (staging flavor)"
  lane :build_staging do
    gradle(
      task: "assemble",
      flavor: "staging",
      build_type: "Release"
    )
  end

  desc "Build a signed release APK (prod flavor)"
  lane :build_prod do
    gradle(
      task: "assemble",
      flavor: "prod",
      build_type: "Release"
    )
  end

  desc "Build staging APK and distribute via Firebase App Distribution"
  lane :distribute_staging do
    gradle(
      task: "assemble",
      flavor: "staging",
      build_type: "Release"
    )
    firebase_app_distribution(
      app: ENV['FIREBASE_ANDROID_APP_ID'],
      groups: "internal-testers",
      release_notes: "Automated staging build via Fastlane",
      apk_path: "../build/app/outputs/flutter-apk/app-staging-release.apk",
      firebase_cli_token: ENV['FIREBASE_TOKEN']
    )
  end

  desc "Build prod APK and distribute via Firebase App Distribution"
  lane :distribute_prod do
    bump_build_number
    gradle(
      task: "assemble",
      flavor: "prod",
      build_type: "Release"
    )
    firebase_app_distribution(
      app: ENV['FIREBASE_PROD_APP_ID'],
      groups: "internal-testers",
      release_notes: "Release build from tag #{ENV['GITHUB_REF_NAME']}",
      apk_path: "../build/app/outputs/flutter-apk/app-prod-release.apk",
      firebase_cli_token: ENV['FIREBASE_TOKEN']
    )
  end
end